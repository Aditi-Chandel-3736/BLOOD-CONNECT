# ════════════════════════════════════════════════════════
# BloodConnect settings — copy this file to ".env" and fill it in.
# NEVER commit your real .env file to GitHub (it is in .gitignore).
# ════════════════════════════════════════════════════════

# REQUIRED for the admin dashboard. Choose a long password only you know.
ADMIN_PASSWORD=change-me-to-a-long-private-password

# Signs the login cookie. Leave empty and the app creates a random one
# in the file .flask_secret_key automatically. In production, set a
# long random value (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Email (Gmail App Password — https://support.google.com/accounts/answer/185833)
# Leave empty during development: emails are skipped and logged instead.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Address used in email links (your deployed URL in production)
BASE_URL=http://localhost:5000

# ── Optional ────────────────────────────────────────────
# 1 = show detailed error pages while developing (never in production)
FLASK_DEBUG=0
# 1 = only send the login cookie over HTTPS (turn on in production with HTTPS)
SESSION_COOKIE_SECURE=0
# Log out after this many minutes without activity
SESSION_IDLE_MINUTES=60
# Days BloodConnect pauses alerts after a recorded donation (a reminder setting, not medical advice)
DONATION_ALERT_PAUSE_DAYS=56
# Timezone used to display times, in minutes from UTC (330 = India)
DISPLAY_UTC_OFFSET_MINUTES=330
# 1 = behind a hosting proxy (Railway/Render/Nginx) so rate limits see real IPs
TRUST_PROXY=0
